<mxfile host="switchboard"><diagram id="6-cloudflare" name="6-cloudflare"><mxGraphModel dx="1640" dy="980" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1640" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;b&gt;WHO KNOCKS&lt;/b&gt;" style="text=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#64748b;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="300" height="20" as="geometry"/></mxCell><mxCell id="c2" value="&lt;div style=&quot;font-size:13px;color:#7a2e14;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;✨&lt;/span&gt;&lt;br&gt;&lt;b&gt;claude.ai backend&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:JetBrains Mono,SFMono-Regular,Menlo,monospace;font-weight:normal&quot;&gt;POST switchboard.example.com/mcp&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97757;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="270" height="80" as="geometry"/></mxCell><mxCell id="c3" value="&lt;div style=&quot;font-size:13px;color:#7c2d12;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;🧑‍💻&lt;/span&gt;&lt;br&gt;&lt;b&gt;your browser (once)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:JetBrains Mono,SFMono-Regular,Menlo,monospace;font-weight:normal&quot;&gt;GET switchboard.example.com/authorize or /dashboard&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="20" y="200" width="270" height="80" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div style=&quot;font-size:13px;color:#7c2d12;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;📱&lt;/span&gt;&lt;br&gt;&lt;b&gt;your other web apps&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:JetBrains Mono,SFMono-Regular,Menlo,monospace;font-weight:normal&quot;&gt;GET app.example.com&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="20" y="340" width="270" height="80" as="geometry"/></mxCell><mxCell id="c5" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:15px;color:#7a3d00&quot;&gt;Cloudflare edge&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#f38020&quot;&gt;evaluated top to bottom; most specific Access app wins&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#f38020;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;container=1;collapsible=0;shadow=0;" vertex="1" parent="1"><mxGeometry x="330" y="20" width="760" height="560" as="geometry"/></mxCell><mxCell id="c6" value="&lt;div style=&quot;font-size:13px;color:#7a3d00;line-height:1.25&quot;&gt;&lt;b&gt;WAF custom rule&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;skip for 160.79.104.0/21 on switchboard.*&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f38020;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="360" y="80" width="220" height="70" as="geometry"/></mxCell><mxCell id="c7" value="host is&lt;br&gt;switchboard.example.com?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#f38020;strokeWidth=2;fontFamily=Inter,Helvetica;fontSize=12;fontColor=#7a3d00;fontStyle=1;shadow=1;" vertex="1" parent="1"><mxGeometry x="380" y="190" width="180" height="110" as="geometry"/></mxCell><mxCell id="c8" value="path is&lt;br&gt;/authorize or&lt;br&gt;/dashboard?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#f38020;strokeWidth=2;fontFamily=Inter,Helvetica;fontSize=12;fontColor=#7a3d00;fontStyle=1;shadow=1;" vertex="1" parent="1"><mxGeometry x="640" y="190" width="180" height="110" as="geometry"/></mxCell><mxCell id="c9" value="&lt;div style=&quot;font-size:13px;color:#7a3d00;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;🔐&lt;/span&gt;&lt;br&gt;&lt;b&gt;Access: you + guests&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;allowed emails only · Access adds a JWT&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f38020;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="870" y="160" width="200" height="90" as="geometry"/></mxCell><mxCell id="c10" value="&lt;div style=&quot;font-size:13px;color:#7a3d00;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;🚪&lt;/span&gt;&lt;br&gt;&lt;b&gt;Access: bypass&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;/mcp /token /register /.well-known/*&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f38020;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="870" y="290" width="200" height="90" as="geometry"/></mxCell><mxCell id="c11" value="&lt;div style=&quot;font-size:13px;color:#7a3d00;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;🛡️&lt;/span&gt;&lt;br&gt;&lt;b&gt;Access: your policy&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;*.example.com, unchanged&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f38020;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="380" y="380" width="200" height="100" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Why bypass is safe:&lt;/b&gt; switchboard rejects anything without a valid bearer it issued itself. Only the human step (/authorize) needs Access." style="text=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#7a3d00;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="610" y="365" width="240" height="110" as="geometry"/></mxCell><mxCell id="c13" value="&lt;div style=&quot;font-size:13px;color:#7a3d00;line-height:1.25&quot;&gt;&lt;b&gt;Tunnel ingress (first match wins)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;&lt;b&gt;switchboard.example.com → :8787&lt;/b&gt; · *.example.com → :8090&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f38020;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="600" y="490" width="470" height="70" as="geometry"/></mxCell><mxCell id="c14" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:15px;color:#064e3b&quot;&gt;your server&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;container=1;collapsible=0;shadow=0;" vertex="1" parent="1"><mxGeometry x="1120" y="20" width="500" height="560" as="geometry"/></mxCell><mxCell id="c15" value="&lt;div style=&quot;font-size:13px;color:#312e81;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;🎛️&lt;/span&gt;&lt;br&gt;&lt;b&gt;switchboard  127.0.0.1:8787&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;&lt;div style=&#x27;text-align:left;font-family:JetBrains Mono,Menlo,monospace;font-size:11px;line-height:1.6&#x27;&gt;systemd: switchboard.service (a dedicated user)&lt;br&gt;config ~/.config/switchboard/config.toml&lt;br&gt;state  ~/.local/state/switchboard/switchboard.db&lt;br&gt;secret notify tokens (env file, mode 600)&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6366f1;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="1150" y="80" width="440" height="150" as="geometry"/></mxCell><mxCell id="c16" value="&lt;div style=&quot;font-size:13px;color:#0c4a6e;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;🚦&lt;/span&gt;&lt;br&gt;&lt;b&gt;Reverse proxy :8090 → your apps&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;app.example.com etc.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#0ea5e9;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="1150" y="260" width="440" height="80" as="geometry"/></mxCell><mxCell id="c17" value="&lt;div style=&quot;font-size:13px;color:#334155;line-height:1.25&quot;&gt;&lt;b&gt;your other local services&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;unchanged&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=0;" vertex="1" parent="1"><mxGeometry x="1150" y="370" width="440" height="80" as="geometry"/></mxCell><mxCell id="c18" value="Nothing listens on a public port. cloudflared dials out; the bypass only opens the path to switchboard&#x27;s own token check." style="text=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11;fontColor=#065f46;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="1150" y="470" width="440" height="90" as="geometry"/></mxCell><mxCell id="c19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#d97757;strokeWidth=2.2;endArrow=blockThin;endFill=1;startArrow=none;startFill=1;endSiz
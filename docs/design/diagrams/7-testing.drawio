source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;div style=&quot;font-size:13px;color:#7c2d12;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;📨&lt;/span&gt;&lt;br&gt;&lt;b&gt;Telegram&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="610" width="240" height="100" as="geometry"/></mxCell><mxCell id="c15" value="&lt;div style=&quot;font-size:13px;color:#1e1b4b;line-height:1.25&quot;&gt;&lt;b&gt;capture server&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;local HTTP endpoint that records notifications&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f46e5;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="380" y="610" width="480" height="100" as="geometry"/></mxCell><mxCell id="c16" value="stands in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94a3b8;strokeWidth=1.8;dashed=1;dashPattern=6 4;endArrow=blockThin;endFill=1;startArrow=none;startFill=1;endSize=7;startSize=7;fontSize=10;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;fontColor=#94a3b8;labelBackgroundColor=#ffffff;jumpStyle=arc;" edge="1" parent="1" source="c14" target="c15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c17" value="&lt;div style=&quot;font-size:13px;color:#334155;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;⏱️&lt;/span&gt;&lt;br&gt;&lt;b&gt;the clock&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="240" height="100" as="geometry"/></mxCell><mxCell id="c18" value="&lt;div style=&quot;font-size:13px;color:#1e1b4b;line-height:1.25&quot;&gt;&lt;b&gt;fake timers&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;25 s waits, 30 min parking, 10 min nag run in milliseconds&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f46e5;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="380" y="740" width="480" height="100" as="geometry"/></mxCell><mxCell id="c19" value="stands in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94a3b8;strokeWidth=1.8;dashed=1;dashPattern=6 4;endArrow=blockThin;endFill=1;startArrow=none;startFill=1;endSize=7;startSize=7;fontSize=10;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;fontColor=#94a3b8;labelBackgroundColor=#ffffff;jumpStyle=arc;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c20" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:15px;color:#312e81&quot;&gt;what CI runs on every push&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6366f1&quot;&gt;GitHub Actions · Node 22 + 24 · ~2 min&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;container=1;collapsible=0;shadow=0;" vertex="1" parent="1"><mxGeometry x="910" y="20" width="710" height="620" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b style=&#x27;font-size:14px;color:#1e1b4b&#x27;&gt;unit&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#312e81&#x27;&gt;state machine · broker policy · cursors · config · token store&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#eef2ff;strokeColor=#4f46e5;strokeWidth=1.5;fontFamily=Inter,Helvetica;shadow=1;" vertex="1" parent="1"><mxGeometry x="950" y="512" width="630" height="92" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b style=&#x27;font-size:14px;color:#1e1b4b&#x27;&gt;driver contract&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#312e81&#x27;&gt;one suite, run against FakeDriver, ClaudeDriver+fake-claude, AcpDriver+fake-acp-agent&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#e0e7ff;strokeColor=#4f46e5;strokeWidth=1.5;fontFamily=Inter,Helvetica;shadow=1;" vertex="1" parent="1"><mxGeometry x="985" y="404" width="560" height="92" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b style=&#x27;font-size:14px;color:#1e1b4b&#x27;&gt;MCP end to end&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#312e81&#x27;&gt;start → wait → question → respond → idle → send (resume) → stop, in-memory and HTTP&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#c7d2fe;strokeColor=#4f46e5;strokeWidth=1.5;fontFamily=Inter,Helvetica;shadow=1;" vertex="1" parent="1"><mxGeometry x="1020" y="296" width="490" height="92" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b style=&#x27;font-size:14px;color:#1e1b4b&#x27;&gt;OAuth end to end&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#312e81&#x27;&gt;401 → metadata → CIMD + DCR → /authorize (fake Access JWT) → PKCE → token → refresh → revoke; every bad case&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#a5b4fc;strokeColor=#4f46e5;strokeWidth=1.5;fontFamily=Inter,Helvetica;shadow=1;" vertex="1" parent="1"><mxGeometry x="1055" y="188" width="420" height="92" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b style=&#x27;font-size:14px;color:#1e1b4b&#x27;&gt;conformance&lt;/b&gt;&lt;br&gt;&lt;span style=&#x27;font-size:11px;color:#312e81&#x27;&gt;MCP Inspector CLI lists tools; metadata checked against RFC 8414 / 9728&lt;/span&gt;" style="rounded=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#818cf8;strokeColor=#4f46e5;strokeWidth=1.5;fontFamily=Inter,Helvetica;shadow=1;" vertex="1" parent="1"><mxGeometry x="1090" y="80" width="350" height="92" as="geometry"/></mxCell><mxCell id="c26" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:15px;color:#334155&quot;&gt;on demand, not in CI&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#94a3b8&quot;&gt;needs real logins; run by hand on a real server&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;container=1;collapsible=0;shadow=0;" vertex="1" parent="1"><mxGeometry x="910" y="660" width="710" height="220" as="geometry"/></mxCell><mxCell id="c27" value="&lt;div style=&quot;font-size:13px;color:#4c1d95;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;🔥&lt;/span&gt;&lt;br&gt;&lt;b&gt;live smoke&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;real Claude Code (haiku) + real opencode: start, question, resume. Also refreshes the recorded fixtures fake-claude replays.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8b5cf6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="935" y="720" width="320" height="130" as="geometry"/></mxCell><mxCell id="c28" value="&lt;div style=&quot;font-size:13px;color:#7a2e14;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;📱&lt;/span&gt;&lt;br&gt;&lt;b&gt;connector check&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;add switchboard.example.com/mcp in claude.ai, run one task by text and one by voice&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97757;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="1275" y="720" width="320" height="130" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
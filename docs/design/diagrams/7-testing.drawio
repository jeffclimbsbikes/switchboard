<mxfile host="switchboard"><diagram id="7-testing" name="7-testing"><mxGraphModel dx="1640" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1640" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:15px;color:#334155&quot;&gt;every real dependency has a stand-in&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#94a3b8&quot;&gt;so CI needs no API keys, no Cloudflare, no claude.ai&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#f8fafc;strokeColor=#94a3b8;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;container=1;collapsible=0;shadow=0;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="860" height="860" as="geometry"/></mxCell><mxCell id="c2" value="&lt;div style=&quot;font-size:13px;color:#4c1d95;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;🤖&lt;/span&gt;&lt;br&gt;&lt;b&gt;Claude Code CLI&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8b5cf6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="240" height="100" as="geometry"/></mxCell><mxCell id="c3" value="&lt;div style=&quot;font-size:13px;color:#1e1b4b;line-height:1.25&quot;&gt;&lt;b&gt;fake-claude&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;a 150-line script speaking the same stream-json control protocol; the SDK runs it via pathToClaudeCodeExecutable. Replays recorded turns, asks questions, crashes on cue.&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f46e5;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="380" y="90" width="480" height="100" as="geometry"/></mxCell><mxCell id="c4" value="stands in" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeColor=#94a3b8;strokeWidth=1.8;dashed=1;dashPattern=6 4;endArrow=blockThin;endFill=1;startArrow=none;startFill=1;endSize=7;startSize=7;fontSize=10;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;fontColor=#94a3b8;labelBackgroundColor=#ffffff;jumpStyle=arc;" edge="1" parent="1" source="c2" target="c3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c5" value="&lt;div style=&quot;font-size:13px;color:#4c1d95;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;🧩&lt;/span&gt;&lt;br&gt;&lt;b&gt;OpenCode / any ACP agent&lt;/b&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#8b5cf6;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="240" height="100" as="geometry"/></mxCell><mxCell id="c6" value="&lt;div style=&quot;font-size:13px;color:#1e1b4b;line-height:1.25&quot;&gt;&lt;b&gt;fake-acp-agent&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;built with the ACP SDK&#x27;s agent side: replies, request_permission, elicitation, slow turns, session/resume&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4f46e5;strokeWidth=1.5;align=left;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,
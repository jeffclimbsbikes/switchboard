f;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="845" as="sourcePoint"/><mxPoint x="140" y="845" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c35" value="callback with code" style="html=1;strokeColor=#ea580c;strokeWidth=2;dashPattern=4 4;endArrow=blockThin;endFill=1;startArrow=none;fontSize=11.5;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;fontColor=#ea580c;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="895" as="sourcePoint"/><mxPoint x="520" y="895" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c36" value="&lt;span style=&quot;font-family:JetBrains Mono,Menlo,monospace&quot;&gt;POST /token  code + code_verifier + resource&lt;/span&gt;" style="html=1;strokeColor=#d97757;strokeWidth=2;dashPattern=4 4;endArrow=blockThin;endFill=1;startArrow=none;fontSize=11.5;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;fontColor=#d97757;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="940" as="sourcePoint"/><mxPoint x="1300" y="940" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c37" value="&lt;span style=&quot;font-family:JetBrains Mono,Menlo,monospace&quot;&gt;access token (1 h, aud=/mcp) + rotating refresh token&lt;/span&gt;" style="html=1;strokeColor=#4f46e5;strokeWidth=2;dashed=1;dashPattern=4 4;endArrow=blockThin;endFill=1;startArrow=none;fontSize=11.5;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;fontColor=#4f46e5;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="975" as="sourcePoint"/><mxPoint x="520" y="975" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c38" value="&lt;span style=&quot;font-family:JetBrains Mono,Menlo,monospace&quot;&gt;POST /mcp   Authorization: Bearer …   tools/list ✓&lt;/span&gt;" style="html=1;strokeColor=#d97757;strokeWidth=2;dashPattern=4 4;endArrow=blockThin;endFill=1;startArrow=none;fontSize=11.5;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;fontColor=#d97757;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="1045" as="sourcePoint"/><mxPoint x="1300" y="1045" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c39" value="From here on: every call carries the bearer; Claude refreshes 5 min before expiry. Revoke from switchboard any time → refresh fails → reconnect." style="text=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=11.5;fontColor=#334155;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="320" y="1080" width="520" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
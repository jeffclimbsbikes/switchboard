lvetica,Arial,sans-serif;fontColor=#d97757;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="315" as="sourcePoint"/><mxPoint x="1300" y="315" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c24" value="&lt;span style=&quot;font-family:JetBrains Mono,Menlo,monospace&quot;&gt;{ resource, authorization_servers: [switchboard.example.com] }&lt;/span&gt;" style="html=1;strokeColor=#4f46e5;strokeWidth=2;dashed=1;dashPattern=4 4;endArrow=blockThin;endFill=1;startArrow=none;fontSize=11.5;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;fontColor=#4f46e5;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="350" as="sourcePoint"/><mxPoint x="520" y="350" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c25" value="&lt;span style=&quot;font-family:JetBrains Mono,Menlo,monospace&quot;&gt;GET /.well-known/oauth-authorization-server&lt;/span&gt;" style="html=1;strokeColor=#d97757;strokeWidth=2;dashPattern=4 4;endArrow=blockThin;endFill=1;startArrow=none;fontSize=11.5;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;fontColor=#d97757;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="520" y="390" as="sourcePoint"/><mxPoint x="1300" y="390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c26" value="&lt;span style=&quot;font-family:JetBrains Mono,Menlo,monospace&quot;&gt;S256 · CIMD supported · token auth “none” · endpoints&lt;/span&gt;" style="html=1;strokeColor=#4f46e5;strokeWidth=2;dashed=1;dashPattern=4 4;endArrow=blockThin;endFill=1;startArrow=none;fontSize=11.5;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;fontColor=#4f46e5;labelBackgroundColor=#ffffff;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1300" y="425" as="sourcePoint"/><mxPoint x="520" y="425" as="targetPoint"/></mxGeometry></mxCell><mxCell id="c27" value="&lt;span style=&quot;font
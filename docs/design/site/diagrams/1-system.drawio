<mxfile host="switchboard"><diagram id="1-system" name="1-system"><mxGraphModel dx="1820" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1820" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:15px;color:#7c2d12&quot;&gt;You&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#ea580c&quot;&gt;Jeff, anywhere&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;container=1;collapsible=0;shadow=0;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="240" height="960" as="geometry"/></mxCell><mxCell id="c2" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:15px;color:#7a2e14&quot;&gt;Anthropic&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#d97757&quot;&gt;claude.ai, web + app&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fdf2ec;strokeColor=#d97757;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;container=1;collapsible=0;shadow=0;" vertex="1" parent="1"><mxGeometry x="290" y="20" width="300" height="560" as="geometry"/></mxCell><mxCell id="c3" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:15px;color:#7a3d00&quot;&gt;Cloudflare edge&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#f38020&quot;&gt;rutang.cloud&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#f38020;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;font
<mxfile host="switchboard"><diagram id="1-system" name="1-system"><mxGraphModel dx="1820" dy="1000" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1820" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c1" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:15px;color:#7c2d12&quot;&gt;You (phone / laptop)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#ea580c&quot;&gt;anywhere&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fff7ed;strokeColor=#ea580c;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;container=1;collapsible=0;shadow=0;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="240" height="960" as="geometry"/></mxCell><mxCell id="c2" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:15px;color:#7a2e14&quot;&gt;Claude&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#d97757&quot;&gt;claude.ai · desktop · Claude Code&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fdf2ec;strokeColor=#d97757;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;container=1;collapsible=0;shadow=0;" vertex="1" parent="1"><mxGeometry x="290" y="20" width="300" height="560" as="geometry"/></mxCell><mxCell id="c3" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:15px;color:#7a3d00&quot;&gt;Cloudflare&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#f38020&quot;&gt;DNS · Access · Tunnel (optional)&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#f38020;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;container=1;collapsible=0;shadow=0;" vertex="1" parent="1"><mxGeometry x="620" y="20" width="310" height="960" as="geometry"/></mxCell><mxCell id="c4" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:15px;color:#064e3b&quot;&gt;Your server&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#10b981&quot;&gt;any Linux or macOS machine you control&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ecfdf5;strokeColor=#10b981;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;container=1;collapsible=0;shadow=0;" vertex="1" parent="1"><mxGeometry x="960" y="20" width="840" height="960" as="geometry"/></mxCell><mxCell id="c5" value="&lt;div style=&quot;font-size:13px;color:#7c2d12;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;🎙️📱&lt;/span&gt;&lt;br&gt;&lt;b&gt;Voice or text chat&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;“build me a packing list app”&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="200" height="120" as="geometry"/></mxCell><mxCell id="c6" value="&lt;div style=&quot;font-size:13px;color:#7c2d12;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;💻&lt;/span&gt;&lt;br&gt;&lt;b&gt;Browser&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;adds the connector once · opens /dashboard&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="200" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;div style=&quot;font-size:13px;color:#7c2d12;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;📨&lt;/span&gt;&lt;br&gt;&lt;b&gt;Notifications&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;“done: packing.example.com”&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="200" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Local only?&lt;/b&gt; &lt;code&gt;switchboard stdio&lt;/code&gt; plugs straight into Claude Code or Claude Desktop: no network, no auth, no Cloudflare." style="text=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#7c2d12;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="40" y="730" width="200" height="150" as="geometry"/></mxCell><mxCell id="c9" value="&lt;div style=&quot;font-size:13px;color:#7a2e14;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;✨&lt;/span&gt;&lt;br&gt;&lt;b&gt;Claude&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;talks with you · decides what to delegate · relays questions&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97757;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="310" y="80" width="260" height="120" as="geometry"/></mxCell><mxCell id="c10" value="&lt;div style=&quot;font-size:13px;color:#7a2e14;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;🔌&lt;/span&gt;&lt;br&gt;&lt;b&gt;switchboard connector&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;custom connector · MCP over HTTPS · OAuth bearer token&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97757;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="310" y="250" width="260" height="110" as="geometry"/></mxCell><mxCell id="c11" value="egress 160.79.104.0/21" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#fdf2ec;strokeColor=#d97757;fontColor=#7a2e14;fontSize=11;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="380" width="220" height="28" as="geometry"/></mxCell><mxCell id="c12" value="Claude never touches your server directly. Every step is a tool call that returns in ≤ 25 s; long work is polled with &lt;b&gt;wait&lt;/b&gt;.&lt;br&gt;&lt;br&gt;❓ When the agent asks something, it comes back as a tool result: Claude answers from what you already said, or asks you out loud." style="text=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#7a2e14;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="310" y="425" width="265" height="150" as="geometry"/></mxCell><mxCell id="c13" value="&lt;div style=&quot;font-size:13px;color:#7a3d00;line-height:1.25&quot;&gt;&lt;b&gt;DNS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;switchboard.example.com → tunnel&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f38020;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="640" y="80" width="270" height="64" as="geometry"/></mxCell><mxCell id="c14" value="&lt;div style=&quot;font-size:13px;color:#7a3d00;line-height:1.25&quot;&gt;&lt;b&gt;WAF&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;skip rules for Anthropic&#x27;s range&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f38020;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="640" y="170" width="270" height="64" as="geometry"/></mxCell><mxCell id="c15" value="&lt;div style=&quot;font-size:13px;color:#7a3d00;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;🛡️&lt;/span&gt;&lt;br&gt;&lt;b&gt;Access&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;&lt;div style=&#x27;text-align:left;font-size:11.5px;line-height:1.7;padding-left:6px&#x27;&gt;&lt;code&gt;/mcp&lt;/code&gt; · token · register&lt;br&gt;&amp;nbsp;&amp;nbsp;→ &lt;b&gt;bypass&lt;/b&gt;, switchboard checks the token&lt;br&gt;&lt;code&gt;/authorize&lt;/code&gt; · &lt;code&gt;/dashboard&lt;/code&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;→ &lt;b&gt;you and allowed guests&lt;/b&gt;&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f38020;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="640" y="260" width="270" height="200" as="geometry"/></mxCell><mxCell id="c16" value="&lt;div style=&quot;font-size:13px;color:#7a3d00;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;🚇&lt;/span&gt;&lt;br&gt;&lt;b&gt;Tunnel&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;your server dials out · no open ports&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f38020;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="640" y="490" width="270" height="90" as="geometry"/></mxCell><mxCell id="c17" value="Optional: any HTTPS reverse proxy works. switchboard only needs a public URL and a way to sign the owner in." style="text=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#7a3d00;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="640" y="620" width="270" height="120" as="geometry"/></mxCell><mxCell id="c18" value="&lt;div style=&quot;font-size:13px;color:#064e3b;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;☁️&lt;/span&gt;&lt;br&gt;&lt;b&gt;cloudflared&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;host service&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#10b981;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="985" y="490" width="160" height="90" as="geometry"/></mxCell><mxCell id="c19" value="&lt;div style=&quot;font-size:13px;color:#334155;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;⚙️&lt;/span&gt;&lt;br&gt;&lt;b&gt;config.toml&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;agents · workspaces · users · auth · usage · notify&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#94a3b8;strokeWidth=1.5;dashed=1;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="985" y="820" width="160" height="120" as="geometry"/></mxCell><mxCell id="c20" value="&lt;div style=&quot;text-align:left&quot;&gt;&lt;b style=&quot;font-size:15px;color:#312e81&quot;&gt;switchboard&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#6366f1&quot;&gt;one process · 127.0.0.1:8787 · its MCP instructions tell Claude it is pairing with a real coding agent&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=16;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#eef2ff;strokeColor=#6366f1;strokeWidth=1.5;verticalAlign=top;align=left;spacingLeft=14;spacingTop=8;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;container=1;collapsible=0;shadow=0;" vertex="1" parent="1"><mxGeometry x="1170" y="70" width="610" height="380" as="geometry"/></mxCell><mxCell id="c21" value="tools:  agents · start · send · wait · respond · sessions · stop" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;
=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="200" height="96" as="geometry"/></mxCell><mxCell id="c7" value="&lt;div style=&quot;font-size:13px;color:#7c2d12;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;📨&lt;/span&gt;&lt;br&gt;&lt;b&gt;Telegram&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;“done: packing.rutang.cloud”&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="200" height="110" as="geometry"/></mxCell><mxCell id="c8" value="&lt;div style=&quot;font-size:13px;color:#7c2d12;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;✅&lt;/span&gt;&lt;br&gt;&lt;b&gt;Open the result&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;on WARP, like every app&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#ea580c;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="200" height="110" as="geometry"/></mxCell><mxCell id="c9" value="&lt;div style=&quot;font-size:13px;color:#7a2e14;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;✨&lt;/span&gt;&lt;br&gt;&lt;b&gt;Claude&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;talks with you · decides what to delegate · relays questions&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97757;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="310" y="80" width="260" height="120" as="geometry"/></mxCell><mxCell id="c10" value="&lt;div style=&quot;font-size:13px;color:#7a2e14;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;🔌&lt;/span&gt;&lt;br&gt;&lt;b&gt;switchboard connector&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;custom connector · MCP over HTTPS · OAuth bearer token&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d97757;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="310" y="250" width="260" height="110" as="geometry"/></mxCell><mxCell id="c11" value="egress 160.79.104.0/21" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#fdf2ec;strokeColor=#d97757;fontColor=#7a2e14;fontSize=11;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330" y="380" width="220" height="28" as="geometry"/></mxCell><mxCell id="c12" value="Claude never touches the Pi directly. Every step is a tool call that returns in ≤ 25 s; long work is polled with &lt;b&gt;wait&lt;/b&gt;.&lt;br&gt;&lt;br&gt;❓ When the agent asks something, it comes back as a tool result: Claude answers from what you already said, or asks you out loud." style="text=1;html=1;whiteSpace=wrap;align=left;verticalAlign=top;fontSize=12;fontColor=#7a2e14;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;strokeColor=none;fillColor=none;" vertex="1" parent="1"><mxGeometry x="310" y="425" width="265" height="150" as="geometry"/></mxCell><mxCell id="c13" value="&lt;div style=&quot;font-size:13px;color:#7a3d00;line-height:1.25&quot;&gt;&lt;b&gt;DNS&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;build.rutang.cloud → tunnel&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f38020;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="640" y="80" width="270" height="64" as="geometry"/></mxCell><mxCell id="c14" value="&lt;div style=&quot;font-size:13px;color:#7a3d00;line-height:1.25&quot;&gt;&lt;b&gt;WAF&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;skip rules for Anthropic&#x27;s range&lt;/span&gt;&lt;/div&gt;" style="rounded=1;arcSize=10;absoluteArcSize=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#f38020;strokeWidth=1.5;align=center;verticalAlign=middle;spacing=6;fontFamily=Inter,Helvetica Neue,Helvetica,Arial,sans-serif;shadow=1;" vertex="1" parent="1"><mxGeometry x="640" y="170" width="270" height="64" as="geometry"/></mxCell><mxCell id="c15" value="&lt;div style=&quot;font-size:13px;color:#7a3d00;line-height:1.25&quot;&gt;&lt;span style=&quot;font-size:22px&quot;&gt;🛡️&lt;/span&gt;&lt;br&gt;&lt;b&gt;Access&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#475569;font-family:Inter,Helvetica Neue,Helvetica,Arial,sans-serif;font-weight:normal&quot;&gt;&lt;div style=&#x27;text-align:left;font-size:11.5px;line-height:1.7;padding-left:6p